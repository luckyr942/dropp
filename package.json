{
  "name": "dropp-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "docker:up": "docker-compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f infrastructure/docker/docker-compose.yml down",
    "docker:logs": "docker-compose -f infrastructure/docker/docker-compose.yml logs -f",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "sim:customer": "xcrun simctl openurl A6ED74F6-58E8-4246-9356-0DA6BCCBE55F exp://127.0.0.1:8081",
    "sim:driver": "xcrun simctl openurl 1B252EAB-D89F-4753-B430-DF07407BA8E5 exp://127.0.0.1:8082",
    "sim:both": "xcrun simctl openurl A6ED74F6-58E8-4246-9356-0DA6BCCBE55F exp://127.0.0.1:8081 && xcrun simctl openurl 1B252EAB-D89F-4753-B430-DF07407BA8E5 exp://127.0.0.1:8082"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^1.13.0"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "expo-font": "~11.10.3",
    "expo-linear-gradient": "~12.7.2",
    "expo-location": "~19.0.8",
    "react-native-safe-area-context": "~5.6.0",
    "expo": "~54.0.37",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "version": "1.0.0",
  "description": "# 🚕 Dropp — Distributed Mobility, Delivery & Commerce Platform",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "author": "",
  "license": "ISC"
}
