{
  "expo": {
    "name": "Dropp Driver",
    "slug": "dropp-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B0F17"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dropp.driver"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0F17"
      },
      "package": "com.dropp.driver"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
