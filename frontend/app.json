          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080808"
      },
      "package": "com.dropp.app"
    },
    "web": {
      "favicon": "./assets/1.png"
    }
  }
}
